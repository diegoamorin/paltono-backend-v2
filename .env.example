# development | test | production
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paltono_dev
# Base dedicada de pruebas: se borra y se recrea con las migraciones. Su nombre debe terminar en _test.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/paltono_test
# Swagger en producción: desactivado salvo SWAGGER_ENABLED=true, y entonces exige autenticación básica.
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=
# Clave HMAC de los tokens de acceso; obligatoria en producción.
ACCESS_TOKEN_SECRET=
# Caducidades (ADR 0002); por defecto 15 minutos, 30 días, 24 horas, 30 minutos y 30 minutos.
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_CHANGE_TTL_MINUTES=30
# Peticiones por minuto y dirección en login, registro, reenvío de correos, recuperación de contraseña y cambio de correo.
AUTH_RATE_LIMIT=10
# Resend: sin clave, fuera de producción, los correos se escriben en el log.
RESEND_API_KEY=
MAIL_FROM=Paltono <onboarding@resend.dev>
# Imágenes subidas (ADR 0005): la URL de cada una es esta base más su clave; obligatoria en producción.
# Fuera de producción, por defecto http://localhost:$PORT/images/, servida por el propio backend.
IMAGE_PUBLIC_BASE_URL=
# Carpeta local donde se guardan las imágenes, servida en /images; por defecto storage/images (fuera de git).
IMAGE_STORAGE_DIRECTORY=
# URLs base de los frontends a los que apuntan los enlaces de los correos.
FRONTEND_URL_KPOP=http://localhost:5173
FRONTEND_URL_MAIN=http://localhost:5174
