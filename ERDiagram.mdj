							"primaryKey": true,
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "e47efbbe3e4b4fa59bc48c51b902d741",
							"_parent": {
								"$ref": "47e816b5462f44f9a1477e467b55c94a"
							},
							"name": "source_id",
							"documentation": "General source within the same proposal.",
							"type": "UUID",
							"primaryKey": true,
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "d25c667edeb74231a4c6473d5fd226d1",
