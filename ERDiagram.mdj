							"type": "UUID",
							"foreignKey": true
						}
					]
				},
				{
					"_type": "ERDEntity",
					"_id": "12dda4696ea44355bad0bbe199258e2d",
					"_parent": {
						"$ref": "dc6874edb22f477fb2927a700c06cfbe"
					},
					"name": "change_decisions",
					"ownedElements": [
						{
							"_type": "ERDRelationship",
							"_id": "5d4431becece4f4691703e1cf8202f0c",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "applying decision",
							"documentation": "UNIQUE decision_id. Composite FK (decision_id,change_id) -> change_decisions(id,change_id). Only apply/apply_rebased -> applied.",
							"end1": {
								"_type": "ERDRelationshipEnd",
								"_id": "18b56900ca734427acc622723ca17251",
								"_parent": {
									"$ref": "5d4431becece4f4691703e1cf8202f0c"
								},
								"reference": {
									"$ref": "12dda4696ea44355bad0bbe199258e2d"
								}
							},
							"end2": {
								"_type": "ERDRelationshipEnd",
								"_id": "673f5ff9326b461f88797d8a26cf5440",
								"_parent": {
									"$ref": "5d4431becece4f4691703e1cf8202f0c"
								},
								"reference": {
									"$ref": "fec175f1ea29479c93e142df16565d67"
								},
								"cardinality": "0..1"
							},
							"identifying": false
						}
					],
					"documentation": "Append-only decision history, never overwrite original proposal values. UNIQUE(id,change_id). Actions and status transitions restricted by docs/editorial-contributions.md. actor_id may be NULL only for automatic mark_conflict, mark_satisfied, block_dependency or mark_obsolete decisions; mark_obsolete results in blocked; automatic decisions cannot approve. Applying requires an active moderator/admin, withdrawal of published content requires active admin, and withdraw_change permits author or staff. Reasons mandatory for conflict, rejection, rebased application, dependency failure and obsolete payload version. Store actual observed target/version; application and revision are one transaction. Author and staff may read; not part of public proposal projection. All FKs ON DELETE RESTRICT. Decisions are allowed only on submitted open proposals, never private drafts. Draft edits/deletion do not produce moderation decisions.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "7ede2875644446a0b4da4a22ad53d9fe",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "id",
							"type": "UUID",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "f20059c4cbc649779b626aedcbe34ae1",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "change_id",
							"documentation": "FK -> proposal_changes.id.",
							"type": "UUID",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "6f3d1de851614bcf9f8415b914daef44",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "actor_id",
							"documentation": "FK -> users.id; NULL only for permitted system decisions.",
							"type": "INTEGER",
							"foreignKey": true,
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "1bd94da761f64be6a55c63beaf83f05d",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "action",
							"documentation": "apply | apply_rebased | reject | mark_conflict | mark_satisfied | block_dependency | mark_obsolete | withdraw_change",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "53be7799ee6a4b1d8db3cbbf48667c8a",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "previous_status",
							"documentation": "pending | conflicted | applied | rejected | satisfied | blocked | withdrawn",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "1b97207f22844608a342e9837c86881f",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "resulting_status",
							"documentation": "pending | conflicted | applied | rejected | satisfied | blocked | withdrawn",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "43a5569ad6334fa7b3bad5949cb7ebc2",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "reason",
							"documentation": "Internal rationale; mandatory on conflict/reject/apply_rebased/block_dependency/mark_obsolete.",
							"type": "TEXT",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "3c1b732c632f478c835d70311e5a3ab1",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "observed_version",
							"documentation": "CHECK >= 0. Root version checked while deciding.",
							"type": "BIGINT"
						},
						{
							"_type": "ERDColumn",
							"_id": "91f7a8feec45435a885d1bb82b5cccc7",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "observed_value",
							"documentation": "Actual envelope observed; preserves current base used to resolve a conflict. NULL only for an automatic mark_obsolete or block_dependency on a microchange whose obsolete payload_schema_version can no longer be read: nothing was observed.",
							"type": "JSONB",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "07f874300eac4b25a26a1334696abf7e",
							"_parent": {
								"$ref": "12dda4696ea44355bad0bbe199258e2d"
							},
							"name": "decided_at",
							"type": "TIMESTAMPTZ"
						}
					]
				},
				{
					"_type": "ERDEntity",
					"_id": "fec175f1ea29479c93e142df16565d67",
					"_parent": {
						"$ref": "dc6874edb22f477fb2927a700c06cfbe"
					},
					"name": "entity_revisions",
					"documentation": "Append-only applied changes only; no row for rejected, conflicted or satisfied proposals. UNIQUE(entity_id,version), UNIQUE(change_id), UNIQUE(decision_id). FK (change_id,entity_id) -> proposal_changes(id,entity_id); FK (decision_id,change_id) -> change_decisions(id,change_id). Decision action must be apply/apply_rebased and result applied. version=observed_version+1 under root lock; entity.current_version equals latest committed version. before_value is actual old value, including rebase; after_value is actual resolved applied value. One revision per microchange; grouped revisions become visible together. before_value/after_value follow the payload_schema_version of their microchange, reached through change_id. A revision is a record, never re-executed: a correction is a new microchange on the current state. All FKs ON DELETE RESTRICT.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "71eb676625ff48e8b700e6e61fb80509",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "id",
							"type": "UUID",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "39805cd44de04cf0aabbe0a9342c8350",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "entity_id",
							"documentation": "FK -> editorial_entities.id.",
							"type": "UUID",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "dae6a2cf71de4cb9b9bac29a3ad6a64f",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "version",
							"documentation": "CHECK > 0; sequential per root.",
							"type": "BIGINT"
						},
						{
							"_type": "ERDColumn",
							"_id": "c31bc99b3a1c4162903835fbd44c2c0c",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "change_id",
							"documentation": "UNIQUE composite FK with entity_id to the applied microchange.",
							"type": "UUID",
							"foreignKey": true,
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "507b20dff0d742a5bfbb74d44cc85ca0",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "decision_id",
							"documentation": "UNIQUE composite FK with change_id to its applying decision.",
							"type": "UUID",
							"foreignKey": true,
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "55bd194293174475aae5f02bf25eb511",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "before_value",
							"documentation": "Actual pre-application target envelope, not necessarily original proposal base.",
							"type": "JSONB"
						},
						{
							"_type": "ERDColumn",
							"_id": "6999f2b15db64e82911054efab9748ee",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "after_value",
							"documentation": "Actual persisted target envelope; root/child references resolved.",
							"type": "JSONB"
						},
						{
							"_type": "ERDColumn",
							"_id": "7267b3ef27e840eb9c5a6316c4977daf",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "result_key",
							"documentation": "Generated domain PK/composite key for create_entity/add_relation; preserves mapping from change UUID.",
							"type": "JSONB",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "83b061fe4539482d9347f6e8814acc54",
							"_parent": {
								"$ref": "fec175f1ea29479c93e142df16565d67"
							},
							"name": "applied_at",
							"type": "TIMESTAMPTZ"
						}
					]
				},
				{
					"_type": "ERDEntity",
					"_id": "189dc0c50d2e44698bd82384e7f786e1",
					"_parent": {
						"$ref": "dc6874edb22f477fb2927a700c06cfbe"
					},
					"name": "user_role_changes",
					"documentation": "Append-only role audit. Referenced users retained through soft deletion; all FKs ON DELETE RESTRICT. changed_by must be an active admin at transaction time, except console-only initial admin bootstrap: changed_by IS NULL, new_role=admin, target account active and email_verified, no existing admin, and a required bootstrap reason. Serialize bootstrap with every role-change path, recheck absence of admins under lock, then update users.role and append audit atomically. CHECK previous_role <> new_role. Match locked users.role to previous_role. User registration defaults to user. NULL actor is never accepted by HTTP role-management endpoints and is not a moderator capability. Role changes are account administration, not public catalog contributions. Preserve at least one active email-verified administrator: reject demotion, suspension or deletion of the last such administrator. Coordinate all role/status/verification changes transactionally, including console paths and concurrent requests.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "969ed79f8c7c4dacb6c4c392f7288ff9",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "id",
							"type": "UUID",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "43249bc1378a44bfb61584d09a5a6afe",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "user_id",
							"documentation": "FK -> users.id; affected account.",
							"type": "INTEGER",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "0cb12f1f10884c579ec188994e795bd3",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "changed_by",
							"documentation": "FK -> users.id; active administrator performing the change. NULL exclusively for console initial admin bootstrap under the table invariants; represents the console operator, not the affected user.",
							"type": "INTEGER",
							"foreignKey": true,
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "8c3a08ea79ea4fc8af147b3b274fb2d1",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "previous_role",
							"documentation": "user | moderator | admin",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "21d1b8fbcd584c23bd9336cbf46c1733",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "new_role",
							"documentation": "user | moderator | admin",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "e11445fb69f343038046ed1de16fb974",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "reason",
							"documentation": "Administrative explanation; not public. Required and non-empty for console initial admin bootstrap; optional otherwise.",
							"type": "TEXT",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "c6a1bcac9bde48ac8e72335d99971d24",
							"_parent": {
								"$ref": "189dc0c50d2e44698bd82384e7f786e1"
							},
							"name": "changed_at",
							"type": "TIMESTAMPTZ"
						}
					]
				},
				{
					"_type": "ERDEntity",
					"_id": "4da200b13764487aa46d398a356953c3",
					"_parent": {
						"$ref": "dc6874edb22f477fb2927a700c06cfbe"
					},
					"name": "user_status_changes",
					"documentation": "Append-only account status audit, approved 2026-10-17. Referenced users retained through soft deletion; all FKs ON DELETE RESTRICT. Transitions: active->suspended and suspended->active only by an active administrator with a required nonblank reason; suspensions have no automatic end and last until manual reactivation. active->deleted by voluntary self-deletion (changed_by = user_id, reason optional). suspended->deleted only by an active administrator at the account holder's out-of-band request, reason required. deleted is terminal. Moderators cannot suspend or reactivate. CHECK previous_status <> new_status. Match locked users.status to previous_status, then update users.status and append this row in one transaction. Suspension revokes all sessions immediately and must preserve the last active email-verified administrator, coordinated with role changes. Not exposed in public history; account administration, not catalog contribution.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "e61158759cdb420b84f50f32f8ad9762",
							"_parent": {
								"$ref": "4da200b13764487aa46d398a356953c3"
							},
							"name": "id",
							"type": "UUID",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "023e63ba84cf4e2b9f5c8293b1070a1a",
							"_parent": {
								"$ref": "4da200b13764487aa46d398a356953c3"
							},
							"name": "user_id",
							"documentation": "FK -> users.id; affected account.",
							"type": "INTEGER",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "37e7f60c781843ba9a90659ed759cb7d",
							"_parent": {
								"$ref": "4da200b13764487aa46d398a356953c3"
							},
							"name": "changed_by",
							"documentation": "FK -> users.id; NOT NULL. Active administrator for suspension, reactivation and deletion of a suspended account at the holder request; the affected account itself for voluntary deletion. No console bootstrap exception.",
							"type": "INTEGER",
							"foreignKey": true,
							"nullable": false
						},
						{
							"_type": "ERDColumn",
							"_id": "530bd2d4a496402d9889f54011273106",
							"_parent": {
								"$ref": "4da200b13764487aa46d398a356953c3"
							},
							"name": "previous_status",
							"documentation": "active | suspended | deleted",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "dd4e7fab2fe14c4c83ea6ec7461508ab",
							"_parent": {
								"$ref": "4da200b13764487aa46d398a356953c3"
							},
							"name": "new_status",
							"documentation": "active | suspended | deleted",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
