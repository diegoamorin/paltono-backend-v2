							},
							"name": "slug",
							"type": "VARCHAR",
							"length": 0,
							"unique": true,
							"documentation": "UNIQUE nonblank slug generated from the work title and retained when the title changes. Resolve collisions with a suffix such as butter-2 under the database uniqueness constraint. Distinct works may share a title. The JSON:API resource id is the BIGINT primary key serialized as a string."
						},
