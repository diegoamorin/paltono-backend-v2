							},
							"name": "status changed_by",
							"documentation": "Required actor FK: administrator for suspension/reactivation, the account itself for voluntary deletion. ON DELETE RESTRICT.",
							"end1": {
								"_type": "ERDRelationshipEnd",
								"_id": "ac4c013cc1be49729ac0b6ea168d9667",
								"_parent": {
									"$ref": "b5c83554310c49bab3fea11b4bd3bb9e"
								},
								"reference": {
									"$ref": "AAAAAAGeD8zCFYF0ZlM="
								},
								"cardinality": "1"
							},
							"end2": {
								"_type": "ERDRelationshipEnd",
								"_id": "25b4053ece0646c3991600f63bc0e841",
								"_parent": {
									"$ref": "b5c83554310c49bab3fea11b4bd3bb9e"
								},
								"reference": {
									"$ref": "4da200b13764487aa46d398a356953c3"
								},
								"cardinality": "0..*"
							},
							"identifying": false
						}
					],
					"documentation": "Global account roles user/moderator/admin. Active users may propose; active moderators/admins may publish directly through the audited contribution flow. Only admins withdraw published roots or manage roles, except the audited console-only initial admin bootstrap described in user_role_changes. Suspended/deleted users cannot submit or decide. Preserve author/reviewer FKs with soft deletion; Authentication policies are documented in docs/adr/0002-local-authentication.md. See docs/editorial-contributions.md. Preserve at least one active email-verified administrator: reject demotion, suspension or deletion of the last such administrator. Coordinate all role/status/verification changes transactionally, including console paths and concurrent requests. Deletion scrub: email=NULL, avatar_url=NULL, bio=NULL, display_name set to the reserved username, user_credentials and user_identities rows removed, sessions and pending tokens revoked/invalidated. Completing password recovery proves mailbox control: it sets email_verified=true and revokes every existing session, transferring control to the mailbox owner. Passwords: length 8..128, no composition rules, Argon2id.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF19G4=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "id",
							"type": "INTEGER",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF2zzs=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "uuid",
							"type": "UUID",
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF3caE=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "username",
							"documentation": "Unique account handle normalized to lowercase. Allowed ASCII letters, digits, underscore and period; length 1..30, including single-letter handles. No hyphen, whitespace, @ or trailing period. TikTok-style character policy with project-specific length and 7-day change interval enforced using username_changed_at. Login accepts handle or email. Public display_name is separate and may contain Unicode. Previous handles are released immediately after a rename; no historical reservation table. Contributions remain attached to the original users.id and display its current username. Author links use stable account identity, never a historical handle. The final handle of a deleted account remains reserved.",
							"type": "VARCHAR",
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF4jqE=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "email",
							"documentation": "Case-insensitive UNIQUE for all non-NULL values; local login. CHECK (email IS NOT NULL OR status = deleted); non-NULL email must be valid and nonblank. Active and suspended accounts require email. Account deletion atomically sets email=NULL, releasing it for a separately registered and reverified account with a new identity; never transfer the previous account history or permissions. No partial uniqueness by status; no NULLS NOT DISTINCT constraint.",
							"type": "VARCHAR",
							"unique": true,
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF5RY8=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "display_name",
							"type": "VARCHAR"
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF6zLk=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "avatar_url",
							"type": "VARCHAR",
							"nullable": true,
							"documentation": "Optional account avatar; NULL when not supplied at registration."
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF7XUk=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "bio",
							"type": "TEXT",
							"nullable": true,
							"documentation": "Optional account biography; NULL when not supplied at registration."
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF8L9E=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "email_verified",
							"type": "BOOLEAN",
							"documentation": "Unverified accounts may authenticate only for verification and managing that restricted access; no editorial actions or recording likes. Password change/recovery revokes all existing sessions; suspension/deletion prevents session authorization."
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF9i3E=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "status",
							"documentation": "active|suspended|deleted. Voluntary deletion requires current password, sets status=deleted and email=NULL atomically, closes sessions, invalidates authentication tokens and hides personal profile while retaining contribution attribution and reserving the final username. Active/suspended accounts require a non-NULL unique email. Re-registering the released email creates an independent account and requires fresh verification. Must preserve the last active email-verified administrator. Other personal-data anonymization remains a separate pending policy. Every status transition is audited in user_status_changes. Suspension and reactivation are admin-only with reason; deletion is terminal. Suspended accounts cannot log in: after a correct password the login returns a specific account-suspended error without the internal reason; a wrong password gets the generic failure. Their submitted proposals stay public and reviewable, but they cannot create, submit or withdraw while suspended; drafts stay private and intact; past decisions remain valid.",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF+A4M=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "role",
							"documentation": "user | moderator | admin; DEFAULT user. Active admins assign/revoke moderator/admin roles; audit in user_role_changes. Sole exception: console-only initial admin bootstrap when no admin exists, promoting an active email-verified account with changed_by NULL under serialized role-change locking. Creatorship grants no editorial privilege.",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYF/mmQ=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "last_login_at",
							"type": "TIMESTAMPTZ",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYGAgKs=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "created_at",
							"type": "TIMESTAMPTZ"
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFYGBoTo=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "updated_at",
							"type": "TIMESTAMPTZ"
						},
						{
							"_type": "ERDColumn",
							"_id": "6bcb1fb0-bc0a-47a4-8056-b1cabb7c20ba",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFYF0ZlM="
							},
							"name": "username_changed_at",
							"documentation": "NOT NULL TIMESTAMPTZ set on initial username assignment at registration and each subsequent effective change. Allow a change only after 7 full days from this timestamp. Check elapsed time and username uniqueness under the same account lock; write username and timestamp atomically. A normalized no-op does not restart the interval.",
							"type": "TIMESTAMPTZ"
						}
					]
				},
				{
					"_type": "ERDEntity",
					"_id": "AAAAAAGeD8zCFYGFZhs=",
