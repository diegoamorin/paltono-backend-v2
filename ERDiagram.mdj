				{
					"_type": "ERDEntity",
					"_id": "47e816b5462f44f9a1477e467b55c94a",
					"_parent": {
						"$ref": "dc6874edb22f477fb2927a700c06cfbe"
					},
					"name": "change_sources",
					"documentation": "Optional precise evidence mapping. Composite FKs (proposal_id,change_id) -> proposal_changes(proposal_id,id) and (proposal_id,source_id) -> proposal_sources(proposal_id,id) ensure the same proposal. One source can support multiple microchanges. Absence of mappings means proposal-level evidence applies. Immutable after submission. All FKs ON DELETE RESTRICT.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "34bba5caac634beea4b58f28f13a39f6",
							"_parent": {
								"$ref": "47e816b5462f44f9a1477e467b55c94a"
							},
							"name": "change_id",
