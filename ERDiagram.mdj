						{
							"_type": "ERDRelationship",
							"_id": "fJvDP5U30PRpa4WqOYBF",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "release credit",
							"end1": {
								"_type": "ERDRelationshipEnd",
								"_id": "TnF10b9VNPtg9YANzFiT",
								"_parent": {
									"$ref": "fJvDP5U30PRpa4WqOYBF"
								},
								"reference": {
									"$ref": "AAAAAAGeD8zCE4EIN7U="
								}
							},
							"end2": {
								"_type": "ERDRelationshipEnd",
								"_id": "qLodsftYh1C1XMUmIJMU",
								"_parent": {
									"$ref": "fJvDP5U30PRpa4WqOYBF"
								},
								"reference": {
									"$ref": "Q4KHNYV6X3hdPCo1zt2j"
								},
								"cardinality": "0..*"
							},
							"identifying": false
						}
					],
					"documentation": "Edición: one concrete digital publication of a release group. A new edition exists when the tracklist changes (tracks added, removed or reordered), when the audio of any track changes even with equal titles (explicit vs clean, sped up, slowed + reverb, remastered, instrumental; each track points to its own recording), or when a regional edition has different content. Physical formats and packaging variants (photobook, A/B/C versions, vinyl vs CD) are not editions in the MVP. Approved 2026-10-17, superseding the 2026-10-13 minimum: an edition may be published with only its release group; title, cover, date and tracks may be unknown or empty. No placeholder cover or fabricated tracks. Derived availability: cancelled when is_cancelled; upcoming when the known release instant or date is in the future; released when it has passed; unknown without a date. Explicit content is derived from the recordings of its tracks, never stored. Editorial root: editorial_entity_id owns publication state and version; published and withdrawn rows are retained. Publishing an edition requires its release group to be published or published in the same transaction. Creator/approver and sources are traced through proposals, decisions and revisions. See docs/music-catalog-model.md and docs/editorial-contributions.md.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCE4EJTi0=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "id",
							"type": "INTEGER",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCE4EKnQQ=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "uuid",
							"type": "UUID",
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeODqFEDG/XyM=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "public_id",
							"documentation": "Es un ID opaco donde usaremos nanoid para generarlo.\n\nNo usamos un slug tipo /release/thriller-3rklW evitar cambiar la url cuando un artista cambie el nombre del album.",
							"type": "VARCHAR",
							"length": 0,
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "75225c9e35e34b7c8e3a77e2cb2fa113",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "release_group_id",
							"type": "INTEGER",
							"documentation": "NOT NULL FK -> release_groups.id; ON DELETE RESTRICT. Every edition belongs to exactly one release group. Moving an edition to another group is a set_fields change of the edition root; the target group must be published or published in the same transaction.",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCE4EMXCw=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "title",
							"type": "VARCHAR",
							"nullable": true,
							"documentation": "Optional literal edition title. NULL displays the release group title for display only; never copy the fallback. If present, 1..512 characters and not whitespace-only."
						},
						{
							"_type": "ERDColumn",
							"_id": "fbe07eac8ce84fa9bf3a4f3bfb2c17fc",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "edition_name",
							"type": "VARCHAR",
							"documentation": "Optional disambiguation such as Deluxe, Sped Up, Clean or Japan Edition; nonblank when present. UNIQUE NULLS NOT DISTINCT (release_group_id, edition_name): at most one unnamed standard edition per group. Regional editions are named here; no country column in the MVP.",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFIEOMhI=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "release_year",
							"documentation": "Unknown is NULL. Year 1..9999; hierarchical partial Gregorian date. Approved 2026-10-12.",
							"type": "SMALLINT",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFIEPEhE=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "cover_art_url",
							"documentation": "NULL when the cover is unknown. If present, a valid HTTP(S) URL; never store a frontend placeholder. Approved 2026-10-13.",
							"type": "VARCHAR",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFIEQgjk=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "created_at",
							"type": "TIMESTAMPTZ"
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFIERhl4=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "updated_at",
							"type": "TIMESTAMPTZ"
						},
						{
							"_type": "ERDColumn",
							"_id": "d32d4fa8-b022-40b5-95ba-a7554cfd0759",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "release_month",
							"documentation": "Unknown is NULL; month requires year, day requires month; validate Gregorian calendar.",
							"type": "SMALLINT",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "c0d062f5-37f2-4e6b-a394-1a6db13206d7",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "release_day",
							"documentation": "Unknown is NULL; month requires year, day requires month; validate Gregorian calendar.",
							"type": "SMALLINT",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "21cb8a2a435846128df0690f94dc559b",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "release_time",
							"type": "TIME",
							"documentation": "Optional announced local release time. release_time and timezone are both NULL or both set, and only with a full release_year/month/day. Together they define the release instant used for countdowns.",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "8eca85b35bd049ff93bde64ed7e504bb",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "timezone",
							"type": "VARCHAR",
							"documentation": "IANA zone, e.g. Asia/Seoul. Required with release_time and NULL without it. Never inferred from a country.",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "5bbcd7d90c6e47c1b0aac439e47fee3e",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "is_cancelled",
							"type": "BOOLEAN",
							"documentation": "NOT NULL DEFAULT false. A cancelled edition shows no countdown and is never treated as released. Postponement edits the date and time instead; revisions keep previous values."
						},
						{
							"_type": "ERDColumn",
							"_id": "b0aaff419db54464bdf35ab9918a4445",
							"_parent": {
								"$ref": "AAAAAAGeD8zCE4EIN7U="
							},
							"name": "editorial_entity_id",
							"documentation": "NOT NULL UNIQUE FK -> editorial_entities.id; ON DELETE RESTRICT. entity_type=release. Only applied content; reserved drafts have no row here. Enforce matching root type and exclusivity transactionally.",
							"type": "UUID",
							"foreignKey": true,
							"unique": true
						}
					]
				},
				{
					"_type": "ERDEntity",
					"_id": "AAAAAAGeD8zCFIEVo6k=",
					"_parent": {
						"$ref": "AAAAAAGeD8zCEIDLyT4="
					},
					"name": "tracks",
					"documentation": "Una pista dentro de una edición. FKs release_id -> releases.id y recording_id -> recordings.id. UNIQUE (release_id, disc_number, track_number); Release contributions belong to the release, not individual tracks. CHECK disc_number > 0 AND track_number > 0. No UNIQUE individual en release_id/recording_id: una grabación puede aparecer en varias ediciones y posiciones. Approved 2026-10-13: nullable title preserves the edition-specific literal title; displayTitle is derived from title or the currently published and visible recording title, never persisted.",
