					],
					"documentation": "Stable editorial root for identity, work, recording, release group, release edition, event or tour. Reserved roots have version=0, no domain row and NULL creation_change_id/published_at/withdrawn_at. Published or withdrawn roots have exactly one matching domain row, current_version>=1 and nonnull creation_change_id/published_at; withdrawn_at is nonnull iff withdrawn. Enforce type/exclusive root and revision consistency transactionally. Creator equals the creation proposal author, never the approving moderator. Publication does not grant ownership permissions. Retain IDs and historical rows after withdrawal; no cascade deletion. All FKs ON DELETE RESTRICT. See docs/editorial-contributions.md.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "27ff67320bc34ac48c48b8e9207fcce1",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "id",
							"documentation": "Stable editorial UUID; generated when reserving a new root.",
							"type": "UUID",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "5760fb532b7c42f98ad11a4ea98c4836",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "entity_type",
							"documentation": "identity | work | recording | release_group | release | event | tour. Immutable.",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "bd1e755d6a08462383d68045a5f2a799",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "publication_status",
							"documentation": "reserved | published | withdrawn; DEFAULT reserved. Separate from event/tour business status.",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "261e770ddbd74d7683ff3d495d30b686",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "created_by",
							"documentation": "FK -> users.id. Reservation author; must match author of applied creation. Immutable. Attribution follows this stable account reference and displays its current username; a renamed or reassigned handle never transfers authorship.",
							"type": "INTEGER",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "d5abb3c8b6274fa4b97a416468781cb0",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "current_version",
							"documentation": "DEFAULT 0; CHECK >= 0. Increment once per applied microchange, including withdrawal.",
							"type": "BIGINT"
						},
						{
							"_type": "ERDColumn",
							"_id": "0e942308ad8c4b0c9a4e632b06436565",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "creation_change_id",
							"documentation": "UNIQUE FK (creation_change_id,id) -> proposal_changes(id,entity_id). Applied create_entity only; populated atomically at first publication.",
							"type": "UUID",
							"foreignKey": true,
							"nullable": true,
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "9e4cee268b57490d8fa2def07d0b88ad",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "created_at",
							"documentation": "Reservation time.",
							"type": "TIMESTAMPTZ"
						},
						{
							"_type": "ERDColumn",
							"_id": "9eb8018816734bee8104e49f1b13e6d3",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "published_at",
							"documentation": "First publication time; immutable after publication.",
							"type": "TIMESTAMPTZ",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "9b6c67ecb3c74bf18d9021f99d6b651a",
							"_parent": {
								"$ref": "3b7372001e4648e791a1fe4ae735cc03"
							},
							"name": "withdrawn_at",
							"documentation": "Logical withdrawal time; administrator decision required.",
							"type": "TIMESTAMPTZ",
							"nullable": true
						}
					]
				},
