				{
					"_type": "ERDEntity",
					"_id": "92a32306931143e39e7a6bf4d97cf64e",
					"_parent": {
						"$ref": "AAAAAAGeD8zCEIDLyT4="
					},
					"name": "release_groups",
					"documentation": "Lanzamiento: album, EP, single or compilation as announced by its artist or agency, independent of how many editions it has. Approved 2026-10-17. Editorial root: editorial_entity_id owns publication state and version; published and withdrawn rows are retained. A group may be published with only a nonblank title and valid type, before any edition exists, to record an announcement. Owns its title, type, description, repackage link and presentation credits (release_artist_credits). Its release date and upcoming state are derived from its non-cancelled editions, never stored. No automatic merge of groups. See docs/music-catalog-model.md and docs/editorial-contributions.md.",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "b2f1618901814dccb97467e8c503a17a",
							"_parent": {
								"$ref": "92a32306931143e39e7a6bf4d97cf64e"
							},
							"name": "id",
							"type": "INTEGER",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "71bac842841c414e92cac253ccb3b3b7",
							"_parent": {
								"$ref": "92a32306931143e39e7a6bf4d97cf64e"
							},
							"name": "uuid",
							"type": "UUID",
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "1c444639c9624181831c8a587fada558",
							"_parent": {
								"$ref": "92a32306931143e39e7a6bf4d97cf64e"
							},
							"name": "public_id",
							"type": "VARCHAR",
							"documentation": "Opaque stable public ID generated with nanoid; not derived from the title. Never recycle after withdrawal. JSON:API resource identifier.",
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "9730fc2dc6a54d978e52ae83aa98e1a3",
							"_parent": {
								"$ref": "92a32306931143e39e7a6bf4d97cf64e"
							},
							"name": "title",
							"type": "VARCHAR",
							"documentation": "Nonblank title of the release group as announced; 1..512 characters. Titles are not unique."
						},
						{
							"_type": "ERDColumn",
							"_id": "398aec7f8cf64e7188429c71e446141c",
							"_parent": {
								"$ref": "92a32306931143e39e7a6bf4d97cf64e"
							},
							"name": "type",
							"type": "enum",
							"documentation": "album|ep|single|compilation. Editorial classification as announced by the artist or agency, backed by sources; never derived from track count or duration. Editions carry no type of their own."
						},
