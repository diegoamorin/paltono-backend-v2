							"_parent": {
								"$ref": "AAAAAAGeD8zCE4DzTtg="
							},
							"name": "organization_id",
							"documentation": "FK -> organizations.catalog_identity_id. Musical membership, not employment or website permission.",
							"type": "INTEGER",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCE4D2ldU=",
