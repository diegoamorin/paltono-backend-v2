						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGiTFo=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGcG3I="
							},
							"name": "expires_at",
							"type": "TIMESTAMPTZ",
							"documentation": "Absolute session expiry; default 30 days from session creation, configurable. Renewal never extends this deadline."
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGjpFw=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGcG3I="
							},
							"name": "revoked_at",
							"type": "TIMESTAMPTZ",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGkEYM=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGcG3I="
							},
							"name": "created_at",
							"type": "TIMESTAMPTZ"
						}
					],
					"documentation": "Refresh-token session records; store only the token hash. Access tokens use Authorization: Bearer. Browser refresh transport uses HttpOnly Secure cookie with CSRF protection where applicable; mobile/external clients receive refresh tokens explicitly. Configurable defaults: access 15 minutes; absolute session lifetime 30 days. Atomically replace the token hash on renewal, invalidating the old token without extending the absolute session deadline. Password change/recovery revokes all sessions; account suspension/deletion prevents authorization. Check current session/account state as required, rather than relying only on access-token expiry."
				},
				{
					"_type": "ERDEntity",
					"_id": "AAAAAAGeD8zCFoGonxc=",
					"_parent": {
						"$ref": "AAAAAAGeD8zCEIDLyT4="
					},
					"name": "user_tokens",
					"columns": [
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGpACE=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "id",
							"type": "INTEGER",
							"primaryKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGqBl0=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "user_id",
							"type": "INTEGER",
							"foreignKey": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGrPto=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "purpose",
							"documentation": "email_verify|password_reset|email_change",
							"type": "enum"
						},
						{
							"_type": "ERDColumn",
							"_id": "c0f0739d-130b-41ac-9dfe-45f2b56521c6",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "target_email",
							"documentation": "Destination email bound to this token. Required, nonblank and normalized for purpose=email_change; NULL for other purposes. Keep current users.email until confirmation, then enforce uniqueness and consume token atomically.",
							"type": "VARCHAR",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGsGpE=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "token_hash",
							"type": "VARCHAR",
							"unique": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGtGZ8=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "expires_at",
							"type": "TIMESTAMPTZ"
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGukLQ=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "used_at",
							"type": "TIMESTAMPTZ",
							"nullable": true
						},
						{
							"_type": "ERDColumn",
							"_id": "AAAAAAGeD8zCFoGvEhU=",
							"_parent": {
								"$ref": "AAAAAAGeD8zCFoGonxc="
							},
							"name": "created_at",
							"type": "TIMESTAMPTZ"
						}
					],
					"documentation": "One-time hashed authentication tokens with expiry and use tracking. Email change requires the current password to initiate; retain current users.email until the bound target_email is verified. Purpose=email_change iff target_email IS NOT NULL, and target_email must be a valid nonblank normalized email. Recheck user state, token validity and destination uniqueness under lock before atomically updating the email and consuming the token. Other pending email-change tokens must not authorize a later change after this confirmation. Configurable one-time token defaults: email_verify 24 hours; password_reset and email_change 30 minutes. All tokens are bound to user_id and purpose, never resolved to a different account by reused email. Deletion invalidates tokens; old verification, password-reset or email-change tokens cannot authorize a new account reusing the email."
				},
