{
  "name": "paltono-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del catálogo musical colaborativo de Paltono",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:generate": "pnpm typeorm migration:generate",
    "db:reset": "ts-node --transpile-only src/console/db-reset.ts",
    "db:rebuild": "ts-node --transpile-only src/console/db-rebuild.ts",
    "db:seed": "ts-node --transpile-only src/console/db-seed.ts",
    "db:test:prepare": "ts-node --transpile-only src/console/db-test-prepare.ts",
    "admin:bootstrap": "ts-node --transpile-only src/console/admin-bootstrap.ts",
    "openapi:export": "ts-node --transpile-only src/console/openapi-export.ts",
    "payload-schemas:export": "ts-node --transpile-only src/console/payload-schemas-export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "railway": "^3.16.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
